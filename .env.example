# ==========================================
# Variables de Entorno - Frontend (Next.js 16)
# ==========================================

# URL base de la API backend (Express)
NEXT_PUBLIC_API_HOST=http://localhost:4000

# Control de mocks en memoria:
# - "true"  => Utiliza simulación en capa de transporte (desacoplado sin backend)
# - "false" => Realiza peticiones HTTP reales al backend
NEXT_PUBLIC_USE_MOCKS=true
